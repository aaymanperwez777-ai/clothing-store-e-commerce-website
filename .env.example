# Copy to .env and fill in. NEVER commit real secrets.

# Database (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public site URL (SEO, sitemap, reset links)
NEXT_PUBLIC_SITE_URL=https://my-store.vercel.app

# Admin account (overrides default seed password if set)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=strong-password-here

# Razorpay (Optional - COD works without these)
RAZORPAY_KEY_ID=rzp_live_xxxxxx
RAZORPAY_KEY_SECRET=xxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxx

# Cloudinary (Required for persistent production image uploads)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Email Notifications (Required for password reset and status emails)
SMTP_URL=smtps://user:pass@smtp.example.com
EMAIL_FROM="CLOTHING STORE" <noreply@example.com>
